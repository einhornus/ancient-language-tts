# OpenRouter key. Pays for the two LLM calls (IPA, then respelling).
OPENROUTER_API_KEY=
# ElevenLabs key. Pays for the speech synthesis.
ELEVENLABS_API_KEY=

# Optional. ElevenLabs voice id, used for every modern language instead of
# that language's built-in voice.
ELEVENLABS_VOICE_ID=
# Optional. ElevenLabs model (default eleven_v4). eleven_multilingual_v2
# ignores language_code and detects the language from the text.
ANCIENT_TTS_ELEVENLABS_MODEL=
# Optional. Audio encoding (default mp3_44100_128).
ANCIENT_TTS_OUTPUT_FORMAT=
# Optional. Voice settings, each from 0 to 1. Stability defaults to 1
# (a fixed reading). Similarity defaults to 0.75 (clear, short of the
# distortion ElevenLabs warns about at the top of that scale).
ANCIENT_TTS_STABILITY=
ANCIENT_TTS_SIMILARITY=

# Optional. Comma-separated OpenRouter LLM ids, tried in order, instead of
# the built-in tier lists, e.g. anthropic/claude-sonnet-4.5,google/gemini-3-flash-preview
ANCIENT_TTS_LLM_MODELS=
# Optional. Comma-separated OpenRouter LLM ids replacing one built-in tier list.
# The IPA step and the respelling step each ask every model of the tier you name.
ANCIENT_TTS_MODELS_HIGH=
ANCIENT_TTS_MODELS_MEDIUM=
ANCIENT_TTS_MODELS_LOW=
# Optional. Where LLM answers and audio are cached (default .cache/ancient-language-tts).
ANCIENT_TTS_CACHE_DIR=
# Optional. 0 turns both caches off.
ANCIENT_TTS_CACHE=
# Optional. Output-token cap of one LLM call (default 16384). Thinking models
# spend this on reasoning first; too low and the structured answer is lost.
ANCIENT_TTS_MAX_TOKENS=
# Optional. Source characters one IPA call may see (default 1000). A longer
# passage is split on ". ", "? ", and "! ", nearest the middle, and each
# piece is transcribed and respelled on its own.
ANCIENT_TTS_MAX_CHARS=
